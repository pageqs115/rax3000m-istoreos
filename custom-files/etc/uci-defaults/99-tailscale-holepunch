#!/bin/sh
# ====================================================================
# Tailscale 打洞直连修复（首次启动自动执行）
# 根因：Kwrt 默认不向 WAN 放行 Tailscale 的 UDP 监听端口，外部 peer 的
#       直连握手包被防火墙丢弃，只能回落海外 DERP 中转（400ms+）
# 处理：① 放行 WAN 入站 UDP 41641/41642（各版本默认端口不同，一并放行）
#       ② 把 tailscale 接口并入 lan 防火墙 zone（否则 fw4 默认 drop，
#          外网经 Tailscale 进不了后台/内网）
#       ③ 建 tailscale 网络接口（tailscale0），tailscaled 一起来即入 zone
# ====================================================================
[ -x /sbin/uci ] || exit 0

# ① WAN 放行 Tailscale UDP
if ! uci -q show firewall | grep -q "Allow-Tailscale"; then
	uci -q batch <<-EOC
		add firewall rule
		set firewall.@rule[-1].name='Allow-Tailscale'
		set firewall.@rule[-1].src='wan'
		set firewall.@rule[-1].proto='udp'
		set firewall.@rule[-1].dest_port='41641 41642'
		set firewall.@rule[-1].target='ACCEPT'
		commit firewall
	EOC
fi

# ② tailscale 接口并入 lan zone
if ! uci -q get firewall.@zone[0].network 2>/dev/null | grep -qw tailscale; then
	uci -q add_list firewall.@zone[0].network='tailscale'
	uci -q commit firewall
fi

# ③ tailscale0 网络接口（proto none，设备出现即 up）
if ! uci -q get network.tailscale >/dev/null 2>&1; then
	uci -q set network.tailscale='interface'
	uci -q set network.tailscale.proto='none'
	uci -q set network.tailscale.device='tailscale0'
	uci -q commit network
fi

exit 0
